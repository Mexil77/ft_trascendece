{
	"name": "testtailwind",
	"version": "1.0.0",
	"description": "",
	"main": "postcss.config.js",
	"type": "module",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"dev": "concurrently \"npm:watch:ts\" \"npm:watch:tailwind\" \"npm:serve\"",
		"watch:ts": "tsc --watch",
		"watch:tailwind": "tailwindcss -i ./styles.css -o ./dist/styles.css --watch",
		"serve": "nodemon --watch dist --exec \"npx serve . -l 4000\""
	},
