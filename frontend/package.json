{
	"name": "testtailwind",
	"version": "1.0.0",
	"description": "",
	"main": "postcss.config.js",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"dev": "concurrently \"npm:watch:ts\" \"npm:watch:tailwind\" \"npm:serve\"",
		"watch:ts": "tsc --watch",
		"watch:tailwind": "tailwindcss -i ./styles.css -o ./public/styles.css --watch",
		"serve": "nodemon --watch public --exec \"npx serve public\""
	},
